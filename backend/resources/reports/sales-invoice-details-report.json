{
    "format": "erp-custom-report",
    "version": 1,
    "slug": "sales-invoice-details-report",
    "name": "Sales Invoice Details Report",
    "category": "Sales & Hire Purchase",
    "description": null,
    "sql_query": "SELECT\n    h.Invoice_no                                                AS invoice_no,\n    h.Invoice_date                                              AS invoice_date,\n    COALESCE(NULLIF(d.Item_s_code, ''), d.Item_code)            AS model,\n    COALESCE(NULLIF(d.Item_description, ''), i.item_description) AS item_description,\n    d.QTY                                                       AS qty,\n    d.Unit_price                                                AS unit_price,\n    d.QTY * d.Unit_price                                        AS gross_amount,\n    d.QTY * d.Unit_price - d.Net_value                          AS discount,\n    d.Net_value                                                 AS net_value,\n    COALESCE(ib.purchase_price, i.standard_purchase_price, 0)   AS purchase_price,\n    d.QTY * COALESCE(ib.purchase_price, i.standard_purchase_price, 0)               AS total_purchase_price,\n    d.Net_value - d.QTY * COALESCE(ib.purchase_price, i.standard_purchase_price, 0) AS profit\nFROM t_invoice_deils d\nJOIN t_invoice_sums h      ON h.Invoice_no = d.Invoice_no\nLEFT JOIN items i          ON i.item_code  = d.Item_code\nLEFT JOIN item_batches ib  ON ib.batch_no  = d.batch_no\n                          AND ib.item_code = d.Item_code\n                          AND ib.store_id  = d.store_id\nWHERE h.BC = :bc\n  AND h.Invoice_date BETWEEN :from AND :to\n  AND (:store_id    IS NULL OR d.store_id      = :store_id)\n  AND (:salesman_id IS NULL OR h.salesman_id   = :salesman_id)\n  AND (:customer    IS NULL OR h.customer_code = :customer)\n  AND (:item_code   IS NULL OR d.Item_code     = :item_code)\n  AND (:search      IS NULL OR h.Invoice_no       LIKE CONCAT('%', :search, '%')\n                            OR d.Item_code        LIKE CONCAT('%', :search, '%')\n                            OR d.Item_description LIKE CONCAT('%', :search, '%'))\nORDER BY h.Invoice_date, h.Invoice_no, d.id;",
