{
    "format": "erp-custom-report",
    "version": 1,
    "slug": "supplier-details",
    "name": "Supplier Details",
    "category": "Supplier",
    "description": null,
    "sql_query": "SELECT\n    s.name,\n    REPLACE(REPLACE(s.address, '\\r', ''), '\\n', ', ')         AS address,\n    s.phone,\n    CASE s.type\n        WHEN 'normal'  THEN 'Normal'\n        WHEN 'service' THEN 'Service'\n        ELSE s.type\n    END                                                        AS type\nFROM suppliers s\nWHERE s.BC = :bc\n  AND (:type   IS NULL OR s.type = :type)\n  AND (:search IS NULL OR s.name    LIKE CONCAT('%', :search, '%')\n                       OR s.phone   LIKE CONCAT('%', :search, '%')\n                       OR s.address LIKE CONCAT('%', :search, '%'))\nORDER BY s.name;",
    "parameters": [
        {
            "name": "type",
            "label": "Type",
            "type": "select",
            "required": false,
            "default": null,
            "source": "list",
            "options": [
                {
                    "value": "normal",
                    "label": "Normal"
                },
                {
                    "value": "service",
                    "label": "Service"
                }
            ]
        },
        {
