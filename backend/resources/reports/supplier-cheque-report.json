{
    "format": "erp-custom-report",
    "version": 1,
    "slug": "supplier-cheque-report",
    "name": "Supplier Cheque Report",
    "category": "Supplier",
    "description": null,
    "sql_query": "SELECT\n    DATE(q.created_at)                                        AS issued_date,\n    q.cheques_no                                              AS cheque_no,\n    q.bank,\n    q.branch_code                                             AS bank_branch,\n    q.acc_no                                                  AS account_no,\n    q.release_date,\n    CASE q.trans_type\n        WHEN 'PURCHASE'         THEN 'Payment at Purchase'\n        WHEN 'SUPPLIER_PAYMENT' THEN 'Supplier Payment'\n        ELSE REPLACE(q.trans_type, '_', ' ')\n    END                                                       AS paid_for,\n    q.trans_no                                                AS reference_no,\n    s.Code                                                    AS supplier_code,\n    s.name                                                    AS supplier_name,\n    s.phone                                                   AS supplier_phone,\n    q.amount,\n    CONCAT(UPPER(LEFT(q.status, 1)), SUBSTRING(q.status, 2))  AS status,\n    q.realized_date,\n    q.return_reason,\n    CASE\n        WHEN q.status = 'pending' AND q.release_date < CURDATE() THEN DATEDIFF(CURDATE(), q.release_date)\n        ELSE NULL\n    END                                                       AS days_past_release\nFROM t_sup_cheques q\nLEFT JOIN t_purchases_sums h    ON q.trans_type = 'PURCHASE'         AND h.Invoice_no = q.trans_no\nLEFT JOIN t_supplier_payments p ON q.trans_type = 'SUPPLIER_PAYMENT' AND p.Payment_no = q.trans_no\nLEFT JOIN suppliers s           ON s.Code = COALESCE(h.supplier_code, p.Supplier_Code)\nWHERE q.BC = :bc\n  AND (\n      (COALESCE(:date_by, 'release') = 'release' AND q.release_date BETWEEN :from AND :to)\n   OR (:date_by = 'issued'                       AND DATE(q.created_at) BETWEEN :from AND :to)\n   OR (:date_by = 'realized'                     AND q.realized_date BETWEEN :from AND :to)\n  )\n  AND (:status   IS NULL OR q.status = :status)\n  AND (:supplier IS NULL OR s.Code   = :supplier)\n  AND (:search   IS NULL OR q.cheques_no LIKE CONCAT('%', :search, '%')\n                         OR q.trans_no   LIKE CONCAT('%', :search, '%'))\nORDER BY q.release_date, q.cheques_no;",
