{
    "format": "erp-custom-report",
    "version": 1,
    "slug": "payment-voucher-report",
    "name": "Payment Voucher Report",
    "category": "Financial",
    "description": null,
    "sql_query": "SELECT\n    v.invoice_no                                              AS voucher_no,\n    v.date                                                    AS voucher_date,\n    v.drcode                                                  AS account_code,\n    COALESCE(dr.description, v.drcode)                        AS expense_account,\n    v.description,\n    CONCAT(UPPER(LEFT(v.payment_method, 1)), SUBSTRING(v.payment_method, 2)) AS payment_method,\n    COALESCE(cr.description, v.crcode)                        AS paid_from,\n    COALESCE(CONCAT(bd.bank_name, ' - ', bd.account_no), '')  AS bank_account,\n    CONCAT(UPPER(LEFT(v.status, 1)), SUBSTRING(v.status, 2))  AS status,\n    v.UID                                                     AS entered_by,\n    v.amount\nFROM t_payment_vouchers v\nLEFT JOIN m_chartof_accounts dr ON dr.code = v.drcode\nLEFT JOIN m_chartof_accounts cr ON cr.code = v.crcode\nLEFT JOIN bank_details bd       ON bd.id   = v.bank_detail_id\nWHERE v.BC = :bc\n  AND v.date BETWEEN :from AND :to\n  AND ((:status IS NULL AND v.status <> 'cancelled') OR v.status = :status)\n  AND (:payment_method IS NULL OR v.payment_method = :payment_method)\n  AND (:account        IS NULL OR v.drcode = :account)\n  AND (:search         IS NULL OR v.invoice_no  LIKE CONCAT('%', :search, '%')\n                               OR v.description LIKE CONCAT('%', :search, '%'))\nORDER BY v.date, v.invoice_no;",
    "parameters": [
        {
            "name": "from",
            "label": "From",
            "type": "date",
            "required": true,
            "default": "first day of this month",
            "source": null,
