{
    "format": "erp-custom-report",
    "version": 1,
    "slug": "item-details",
    "name": "Item Details",
    "category": "Stock Reports",
    "description": null,
    "sql_query": "SELECT\n    i.item_code,\n    i.item_description,\n    i.standard_purchase_price AS purchase_price,\n    i.standard_sales_price    AS sales_price\nFROM items i\nLEFT JOIN categories c ON c.id = i.category_id\nWHERE i.BC = :bc\n  AND (:category IS NULL OR i.category_id = :category OR c.parent_id = :category)\n  AND (:search IS NULL OR i.item_code LIKE CONCAT('%', :search, '%')\n                       OR i.item_description LIKE CONCAT('%', :search, '%'))\nORDER BY i.item_code",
    "parameters": [
        {
            "name": "category",
            "label": "Category",
            "type": "select",
            "required": false,
            "default": null,
            "source": "categories",
            "options": []
