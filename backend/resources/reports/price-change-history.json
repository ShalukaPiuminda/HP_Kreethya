{
    "format": "erp-custom-report",
    "version": 1,
    "slug": "price-change-history",
    "name": "Price Change History",
    "category": "Stock Reports",
    "description": "Every batch and standard price change with old and new prices, who changed it and why.",
    "sql_query": "SELECT\n    pr.revision_no,\n    pr.created_at                              AS changed_at,\n    pr.item_code,\n    i.item_description,\n    COALESCE(s.name, '-')                      AS store_name,\n    COALESCE(l.batch_no, 'Standard price')     AS batch_no,\n    l.old_purchase_price,\n    l.new_purchase_price,\n    l.old_sales_price,\n    l.new_sales_price,\n    l.new_sales_price - l.old_sales_price      AS sales_change,\n    CASE\n        WHEN l.old_sales_price > 0\n            THEN ROUND((l.new_sales_price - l.old_sales_price) * 100 / l.old_sales_price, 2)\n        ELSE NULL\n    END                                        AS sales_change_pct,\n    CASE pr.source\n        WHEN 'manual'   THEN 'Manual'\n        WHEN 'reversal' THEN 'Reversal'\n        WHEN 'OPS'      THEN 'Opening stock'\n        ELSE pr.source\n    END                                        AS source,\n    pr.source_no,\n    CASE pr.status WHEN 'reversed' THEN 'Reversed' ELSE 'Applied' END AS status,\n    pr.UID                                     AS changed_by,\n    pr.reason\nFROM price_revisions pr\nJOIN price_revision_lines l ON l.price_revision_id = pr.id\nLEFT JOIN items i ON i.item_code = pr.item_code AND i.BC = pr.BC\nLEFT JOIN stores s ON s.id = l.store_id\nWHERE pr.BC = :bc\n  AND (:from IS NULL OR DATE(pr.created_at) >= :from)\n  AND (:to IS NULL OR DATE(pr.created_at) <= :to)\n  AND (:item_code IS NULL OR pr.item_code = :item_code)\n  AND (:store_id IS NULL OR l.store_id = :store_id)\n  AND (:source IS NULL OR pr.source = :source)\n  AND (:changed_by IS NULL OR pr.UID LIKE CONCAT('%', :changed_by, '%'))\n  AND (:search IS NULL OR pr.revision_no LIKE CONCAT('%', :search, '%')\n                       OR pr.item_code LIKE CONCAT('%', :search, '%')\n                       OR i.item_description LIKE CONCAT('%', :search, '%')\n                       OR pr.reason LIKE CONCAT('%', :search, '%'))\nORDER BY pr.created_at DESC, pr.id DESC, l.id ASC;",
    "parameters": [
