{
    "format": "erp-custom-report",
    "version": 1,
    "slug": "sales-summary-report",
    "name": "Sales Summary Report",
    "category": "Sales & Hire Purchase",
    "description": null,
    "sql_query": "SELECT\n    h.Invoice_no                         AS invoice_no,\n    h.Invoice_date                       AS invoice_date,\n    h.Customer_NIC                       AS customer_nic,\n    h.Customer_Name                      AS customer_name,\n    h.Gross_Amount                       AS gross_amount,\n    h.Discount                           AS discount,\n    h.Net_Amount                         AS net_amount,\n    h.Cash_Pay                           AS cash_pay,\n    h.Credite                            AS credite,\n    h.Cheque                             AS cheque\nFROM t_invoice_sums h\nWHERE h.BC = :bc\n  AND h.Invoice_date BETWEEN :from AND :to\n  AND (:store_id    IS NULL OR h.store_id      = :store_id)\n  AND (:salesman_id IS NULL OR h.salesman_id   = :salesman_id)\n  AND (:customer    IS NULL OR h.customer_code = :customer)\n  AND (:search      IS NULL OR h.Invoice_no    LIKE CONCAT('%', :search, '%')\n                            OR h.Customer_NIC  LIKE CONCAT('%', :search, '%')\n                            OR h.Customer_Name LIKE CONCAT('%', :search, '%'))\nORDER BY h.Invoice_date, h.Invoice_no;",
