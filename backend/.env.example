APP_NAME="Hire Purchase ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost:8008

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_db
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
ERP_DEMO_PASSWORD=password

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:3001,127.0.0.1:3001

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Report Builder
# Reports are saved as JSON files in resources/reports (copy them with the project;
# they load automatically on a new installation). Set to false to keep reports only in the database.
REPORTS_WRITE_FILES=true
REPORTS_AUTO_SYNC=true
# Optional SELECT-only MySQL user for custom report queries (recommended on servers)
DB_REPORTS_USERNAME=
DB_REPORTS_PASSWORD=

# Hidden developer account (php artisan erp:developer-user)
DEVELOPER_PASSWORD=
DEVELOPER_BC=

# Notify.lk SMS gateway
NOTIFYLK_URL=https://app.notify.lk/api/v1/send
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=
SMS_REMINDER_TIME=09:00
NOTIFYLK_CA_BUNDLE=

# Help desk -> vendor Task Manager (key from Task Manager > Customers > Help Desk Key)
TASK_MANAGER_API_URL=
TASK_MANAGER_API_KEY=
